# Optional, matching-architecture GPU runtime. Missing/foreign artifacts never
# replace the application's known-compatible CPU libraries.
function(add_local_asr_worker)
  if(WIN32)
    string(TOLOWER "${CMAKE_GENERATOR_PLATFORM};${CMAKE_SYSTEM_PROCESSOR}" asr_platform)
    set(asr_os windows)
    set(asr_name asr_worker.exe)
  else()
    string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" asr_platform)
    set(asr_os linux)
    set(asr_name asr_worker)
  endif()
  if(asr_platform MATCHES "arm64|aarch64")
    set(asr_arch arm64)
  elseif(asr_platform MATCHES "x64|x86_64|amd64")
    set(asr_arch x64)
  else()
    message(STATUS "ASR acceleration unavailable on this architecture; CPU retained")
    return()
  endif()
  get_filename_component(asr_repo "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
  set(asr_source "${asr_repo}/native/asr/prebuilt/${asr_os}-${asr_arch}")
  install(CODE "file(REMOVE \"${CMAKE_INSTALL_PREFIX}/resources/asr/${asr_name}\")" COMPONENT Runtime)
  if(NOT EXISTS "${asr_source}/${asr_name}" OR NOT EXISTS "${asr_source}/manifest.json")
    message(STATUS "ASR GPU component is not staged; CPU retained (tool/build_asr_accelerator.py)")
    return()
  endif()
  file(READ "${asr_source}/manifest.json" asr_manifest)
  foreach(source native/asr/asr_accelerator.cpp native/asr/firered_ctc.h native/asr/session_options.inc
      native/asr/fluent_asr_observer.h native/asr/CMakeLists.txt tool/prepare_asr_native.py
      native/asr/mnn_session.h native/asr_mnn/mnn_graph.h)
    string(JSON expected_source_hash ERROR_VARIABLE source_hash_error GET "${asr_manifest}" sourceHashes "${source}")
    file(SHA256 "${asr_repo}/${source}" actual_source_hash)
    if(source_hash_error OR NOT expected_source_hash STREQUAL actual_source_hash)
      message(STATUS "ASR GPU component needs rebuilding after source changes; CPU retained")
      return()
    endif()
  endforeach()
  string(JSON mnn_source_count ERROR_VARIABLE mnn_sources_error LENGTH "${asr_manifest}" mnnSourceHashes)
  if(NOT mnn_sources_error AND mnn_source_count GREATER 0)
    math(EXPR mnn_last_source "${mnn_source_count} - 1")
    foreach(index RANGE 0 ${mnn_last_source})
      string(JSON source MEMBER "${asr_manifest}" mnnSourceHashes ${index})
      if(NOT source MATCHES "^[a-zA-Z0-9_./-]+$" OR source MATCHES "(^|/)\\.\\.(/|$)" OR NOT EXISTS "${asr_repo}/${source}")
        message(FATAL_ERROR "Invalid ASR MNN source manifest")
      endif()
      string(JSON expected_source_hash GET "${asr_manifest}" mnnSourceHashes "${source}")
      file(SHA256 "${asr_repo}/${source}" actual_source_hash)
      if(NOT expected_source_hash STREQUAL actual_source_hash)
        message(STATUS "ASR MNN component needs rebuilding after source changes; CPU retained")
        return()
      endif()
    endforeach()
  endif()
  string(JSON asr_manifest_os GET "${asr_manifest}" platform)
  string(JSON asr_manifest_arch GET "${asr_manifest}" arch)
  string(JSON asr_manifest_version GET "${asr_manifest}" sherpa)
  if(NOT asr_manifest_os STREQUAL asr_os OR NOT asr_manifest_arch STREQUAL asr_arch OR
      NOT asr_manifest_version STREQUAL "1.12.12")
    message(FATAL_ERROR "ASR component manifest does not match the target/runtime")
  endif()
  file(READ "${asr_source}/${asr_name}" asr_header LIMIT 64 HEX)
  if(WIN32)
    if(NOT asr_header MATCHES "^4d5a")
      message(FATAL_ERROR "ASR Windows helper is not a PE executable")
    endif()
    string(SUBSTRING "${asr_header}" 120 2 pe0)
    string(SUBSTRING "${asr_header}" 122 2 pe1)
    string(SUBSTRING "${asr_header}" 124 2 pe2)
    string(SUBSTRING "${asr_header}" 126 2 pe3)
    math(EXPR pe_machine_at "0x${pe3}${pe2}${pe1}${pe0} + 4")
    file(READ "${asr_source}/${asr_name}" asr_machine OFFSET ${pe_machine_at} LIMIT 2 HEX)
    if((asr_arch STREQUAL x64 AND NOT asr_machine STREQUAL "6486") OR
       (asr_arch STREQUAL arm64 AND NOT asr_machine STREQUAL "64aa"))
      message(FATAL_ERROR "ASR Windows helper has a foreign PE architecture")
    endif()
  else()
    if(asr_arch STREQUAL arm64)
      set(asr_machine b700)
    else()
      set(asr_machine 3e00)
    endif()
    string(SUBSTRING "${asr_header}" 36 4 asr_actual_machine)
    if(NOT asr_header MATCHES "^7f454c460201" OR NOT asr_actual_machine STREQUAL asr_machine)
      message(FATAL_ERROR "ASR Linux helper has a foreign ABI")
    endif()
  endif()
  string(JSON asr_file_count LENGTH "${asr_manifest}" files)
  math(EXPR asr_last_file "${asr_file_count} - 1")
  foreach(index RANGE 0 ${asr_last_file})
    string(JSON asr_file MEMBER "${asr_manifest}" files ${index})
    if(NOT asr_file MATCHES "^[a-zA-Z0-9_.-]+$" OR NOT EXISTS "${asr_source}/${asr_file}")
      message(FATAL_ERROR "ASR component file is missing or invalid")
    endif()
    string(JSON asr_expected_hash GET "${asr_manifest}" files "${asr_file}")
    file(SHA256 "${asr_source}/${asr_file}" asr_actual_hash)
    if(NOT asr_expected_hash STREQUAL asr_actual_hash)
      message(FATAL_ERROR "ASR component no longer matches its immutable staging manifest: ${asr_file}")
    endif()
  endforeach()
  # Use install(FILES/PROGRAMS) for the immutable private directory; no GPU
  # runtime is ever installed into the player's library search directory.
  install(DIRECTORY "${asr_source}/" DESTINATION "${CMAKE_INSTALL_PREFIX}/resources/asr" COMPONENT Runtime)
  if(NOT WIN32)
    install(PROGRAMS "${asr_source}/${asr_name}" DESTINATION "${CMAKE_INSTALL_PREFIX}/resources/asr" COMPONENT Runtime)
  endif()
endfunction()
