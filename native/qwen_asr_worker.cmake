# Install the audio GGUF runtime only into its own private helper directory.
function(add_local_qwen_asr_worker)
  get_filename_component(qwen_repo "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
  if(WIN32)
    set(qwen_os windows)
  else()
    set(qwen_os linux)
  endif()
  string(TOLOWER "${CMAKE_GENERATOR_PLATFORM};${CMAKE_SYSTEM_PROCESSOR}" qwen_machine)
  if(qwen_machine MATCHES "arm64|aarch64")
    set(qwen_arch arm64)
  elseif(qwen_machine MATCHES "x64|x86_64|amd64")
    set(qwen_arch x64)
  else()
    return()
  endif()
  set(qwen_source "${qwen_repo}/native/qwen_asr/prebuilt/${qwen_os}-${qwen_arch}")
  if(NOT EXISTS "${qwen_source}/manifest.json")
    message(STATUS "Qwen audio component not built for this target; existing ASR retained")
    return()
  endif()
  find_package(Python3 COMPONENTS Interpreter REQUIRED)
  execute_process(COMMAND "${Python3_EXECUTABLE}" "${qwen_repo}/tool/verify_qwen_artifact.py"
    "${qwen_source}" --platform "${qwen_os}" --arch "${qwen_arch}"
    COMMAND_ERROR_IS_FATAL ANY)
  install(DIRECTORY "${qwen_source}/" DESTINATION "${CMAKE_INSTALL_PREFIX}/resources/qwen_asr" COMPONENT Runtime)
  if(NOT WIN32)
    install(PROGRAMS "${qwen_source}/qwen_asr_worker" DESTINATION "${CMAKE_INSTALL_PREFIX}/resources/qwen_asr" COMPONENT Runtime)
  endif()
endfunction()
