# Private dependencies never share a directory with text translation or Qwen.
function(add_local_cohere_asr_worker)
  get_filename_component(cohere_repo "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
  if(WIN32)
    set(cohere_os windows)
  else()
    set(cohere_os linux)
  endif()
  string(TOLOWER "${CMAKE_GENERATOR_PLATFORM};${CMAKE_SYSTEM_PROCESSOR}" cohere_machine)
  if(cohere_machine MATCHES "arm64|aarch64")
    set(cohere_arch arm64)
  elseif(cohere_machine MATCHES "x64|x86_64|amd64")
    set(cohere_arch x64)
  else()
    return()
  endif()
  set(cohere_source "${cohere_repo}/native/cohere_asr/prebuilt/${cohere_os}-${cohere_arch}")
  if(NOT EXISTS "${cohere_source}/manifest.json")
    message(STATUS "Cohere audio component not built for this target")
    return()
  endif()
  find_package(Python3 COMPONENTS Interpreter REQUIRED)
  execute_process(COMMAND "${Python3_EXECUTABLE}" "${cohere_repo}/tool/verify_cohere_artifact.py"
    "${cohere_source}" --platform "${cohere_os}" --arch "${cohere_arch}" COMMAND_ERROR_IS_FATAL ANY)
  install(DIRECTORY "${cohere_source}/" DESTINATION "${CMAKE_INSTALL_PREFIX}/resources/cohere_asr" COMPONENT Runtime)
  if(NOT WIN32)
    install(PROGRAMS "${cohere_source}/cohere_asr_worker" DESTINATION "${CMAKE_INSTALL_PREFIX}/resources/cohere_asr" COMPONENT Runtime)
  endif()
endfunction()
