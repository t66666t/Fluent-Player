# Private dependencies never share a directory with text translation or Qwen.
function(add_local_parakeet_ja_worker)
  get_filename_component(parakeet_ja_repo "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
  if(WIN32)
    set(parakeet_ja_os windows)
  else()
    set(parakeet_ja_os linux)
  endif()
  string(TOLOWER "${CMAKE_GENERATOR_PLATFORM};${CMAKE_SYSTEM_PROCESSOR}" parakeet_ja_machine)
  if(parakeet_ja_machine MATCHES "arm64|aarch64")
    set(parakeet_ja_arch arm64)
  elseif(parakeet_ja_machine MATCHES "x64|x86_64|amd64")
    set(parakeet_ja_arch x64)
  else()
    return()
  endif()
  set(parakeet_ja_source "${parakeet_ja_repo}/native/parakeet_ja/prebuilt/${parakeet_ja_os}-${parakeet_ja_arch}")
  if(NOT EXISTS "${parakeet_ja_source}/manifest.json")
    message(STATUS "Japanese Parakeet audio component not built for this target")
    return()
  endif()
  find_package(Python3 COMPONENTS Interpreter REQUIRED)
  execute_process(COMMAND "${Python3_EXECUTABLE}" "${parakeet_ja_repo}/tool/verify_parakeet_ja_artifact.py"
    "${parakeet_ja_source}" --platform "${parakeet_ja_os}" --arch "${parakeet_ja_arch}" COMMAND_ERROR_IS_FATAL ANY)
  install(DIRECTORY "${parakeet_ja_source}/" DESTINATION "${CMAKE_INSTALL_PREFIX}/resources/parakeet_ja" COMPONENT Runtime)
  if(NOT WIN32)
    install(PROGRAMS "${parakeet_ja_source}/parakeet_ja_worker" DESTINATION "${CMAKE_INSTALL_PREFIX}/resources/parakeet_ja" COMPONENT Runtime)
  endif()
endfunction()
