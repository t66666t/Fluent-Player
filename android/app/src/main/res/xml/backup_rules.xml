<?xml version="1.0" encoding="utf-8"?>
<!-- API 24-30: Keystore-bound secrets cannot be restored on another device.
     Exclusion-only rules retain the existing backup policy for all other data. -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
</full-backup-content>
